# ho environment — how it layers (see scripts/dev.mjs):

# LLM (required for matching/fills)
GENERALCOMPUTE_API_KEY=
# GENERALCOMPUTE_MODEL=minimax-m2.7

# Embeddings via Gemini (required for semantic search; endpoint + model
# default in .env.development, key goes here)
GEMINI_API_KEY=

# Discord (required for review prompts + status)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# Gmail (required for verification codes + post-submit feedback; app password,
# 16 chars, from Google Account security settings)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Gmail push via GCP Pub/Sub (instant reward emails; needs OAuth, not app password)
# GMAIL_PUSH=1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GCP_PUBSUB_PROJECT=
# GCP_PUBSUB_TOPIC=ho-gmail-events
# GCP_PUBSUB_SUBSCRIPTION=ho-gmail-events-sub
