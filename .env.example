# ── ho environment (minimal) ─────────────────────────────────────────────
# ONLY these are needed to run. Every other knob has a sane default baked
# into the code; scroll past the divider for the optional tuning vars.

# ── LLM (required) ─────────────────────────────────────────────────────
GENERALCOMPUTE_API_KEY=gc_your_api_key_here
GENERALCOMPUTE_MODEL=deepseek-v3.2

# ── Candidate (required) ───────────────────────────────────────────────
RESUME_URL=https://your-domain.com/resume.pdf
# LaTeX resume source for JD-tailored resumes. When set (or when a repo-root
# resume.tex exists) the autofill pipeline generates a per-job tailored resume
# (lightweight: skills/bullet reordering + exact-keyword mirroring, compiled
# with `tectonic`) and attaches it at the end of the fill. Local path wins over
# the repo-root resume.tex, which wins over RESUME_TEX_URL.
# RESUME_TEX_PATH=/path/to/resume.tex
# RESUME_TEX_URL=https://your-domain.com/resume.tex
# Set to 0 to disable LaTeX tailoring even when a resume.tex exists.
# TAILOR_RESUME=1
# Portfolio / personal website; stored into persona.json identity.website.
PORTFOLIO_URL=https://your-portfolio.com

# ── Discord (required) ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_GUILD_ID=your_guild_id_here

# ── Gmail (required for email-verification codes + post-submit feedback) ─
# GMAIL_APP_PASSWORD must be a 16-character App Password from Google Account
# security settings (standard passwords are not accepted over IMAP).
GMAIL_EMAIL=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — everything below has a default. Set only to tune.
# ─────────────────────────────────────────────────────────────────────────

# Overnight run / pacing
# OVERNIGHT_LOOP=true
# AUTOFILL_QUESTION_TIMEOUT=300        # seconds to wait for a Discord reply
# AUTOFILL_ACTIVITY_TIMEOUT_MS=360000  # abort a stuck browser after this
# AUTOFILL_PACING=3                    # multiply humanizing sleeps (>=1)
# AUTOFILL_TYPING=1                    # per-keystroke typing instead of native fill
# AUTOFILL_TYPING_MAX=400
# AUTOFILL_TYPING_SPEED=3
# AUTOFILL_INTER_JOB_DELAY_MS=60000    # pad between submissions
# AUTOFILL_MAX_CONCURRENT=4            # concurrent browser runs
# AUTOFILL_CONSISTENCY_GATE=1          # auto-correct wrong fields pre-submit
# AUTOFILL_EMAIL_FEEDBACK=1            # read back ATS confirmation/rejection mail
# AUTOFILL_GMAIL_TIMEOUT_MS=60000      # bound the code-email wait

# Proxy (anti-fraud; both optional)
# AUTOFILL_PROXY_TEMPLATE=http://<user>-country-in-session-{SID}:<pass>@geo.iproyal.com:12321
# AUTOFILL_PROXY=socks5://127.0.0.1:9050

# Steel browser backend (steel.dev) — optional, all local.
# When set, the runner creates a per-job Steel session and attaches Stagehand
# via CDP instead of launching a fresh Chrome (direct launch remains the
# fallback). Run the Steel server locally with:
#   docker compose -f packages/ingest/docker-compose.yaml up -d steel
# STEEL_BASE_URL=http://localhost:3000
# STEEL_BROWSER_HEADLESS=true        # Chrome headless inside Steel (true for server use)
# STEEL_CHROME_PATH=                 # custom Chrome binary path for Steel (optional)

# Workday job portals (sign-in / account creation on tenant)
# WORKDAY_EMAIL=your.email@example.com
# WORKDAY_PASSWORD=your_workday_password

# LLM budget (radar matching throughput)
# LLM_QUEUE_RPM=240
# LLM_QUEUE_TPM=400000
# LLM_QUEUE_MAX_IN_FLIGHT=30
# LLM_BUDGET_RADAR_RPM=240
# LLM_BUDGET_RADAR_TPM=400000
# Keep a degraded SearXNG instance from blocking an entire radar sweep.
# SEARXNG_DORK_TIMEOUT=20
# LLM_QUEUE_MATCH_TOKENS=3000

# Radar / pipeline cadence
# SWEEP_INTERVAL=300.0
# SCHEDULER_WORKERS=4
# MAX_QUEUE_SIZE=500
# MATCH_CONCURRENCY=24
# VERIFY_CONCURRENCY=20
# MAX_SCRAPE_WORKERS=18
# PIPELINE_TARGET=15

# Renderer (Firecrawl replacement) tuning
# RENDER_CONCURRENCY=4                 # concurrent JS renders (browser pool)
# RENDER_IDLE_MS=30000                 # close idle browsers after this
# RENDER_HOST_DELAY=0.5                # per-host politeness spacing (s)
# RENDER_CACHE_TTL=600
# RENDER_CACHE_PERSIST=true            # share render cache via Postgres
# RENDER_USE_PROXY=true                # SOCKS5 masking on blocks/challenges
# RENDER_SOCKS_PROXY=socks5://127.0.0.1:9050
# RENDER_SHELL_THRESHOLD_CHARS=200     # JS-shell detection cutoff
# RENDER_SETTLE_MS=2500                # JS-SPA hydration wait

# Infrastructure (defaults are localhost dev stack)
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/agent_memory
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
# SEARXNG_URL=http://localhost:8080/search
# EMBED_URL=http://127.0.0.1:8900/v1
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Gmail push (instant, via GCP Pub/Sub — replaces polling for reward emails)
# Free: Gmail API + Pub/Sub 10 GiB/month free tier. Needs OAuth (not app password).
# Run: uv run python -m ml.scripts.gmail_watch_setup --authorize  → paste refresh token
#      uv run python -m ml.scripts.gmail_watch_setup --arm
# GMAIL_PUSH=1
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token
# GCP_PUBSUB_PROJECT=your-gcp-project
# GCP_PUBSUB_TOPIC=ho-gmail-events
# GCP_PUBSUB_SUBSCRIPTION=ho-gmail-events-sub

# ML / learning system
# ML_GAMMA=0.99
# ML_EXPLORATION_INITIAL=0.30
# ML_EXPLORATION_MATURE=0.05
# ML_EXPLORATION_APPLICATION=0.02
# ML_SHADOW_MODE=true
# ML_TRAIN_WINDOW_DAYS=90
# ML_DATASET_DIR=artifacts/datasets
# ML_ARTIFACT_DIR=artifacts/ml
