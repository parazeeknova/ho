# GeneralCompute Cloud LLM
GENERALCOMPUTE_API_KEY=gc_your_api_key_here
GENERALCOMPUTE_MODEL=deepseek-v3.2

# Firecrawl & Services
PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=CHANGEME
FIRECRAWL_URL=http://127.0.0.1:3002
NEO4J_URI=bolt://127.0.0.1:7687

# Telegram Bot Dispatch
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Seconds to wait for a user's Telegram reply to an unknown screener question
# before skipping it (autofill). Defaults to 300.
# AUTOFILL_QUESTION_TIMEOUT=300

# Overnight runs: if the browser makes no observable progress (stuck fill or
# submit) for this long, the runner aborts the job instead of hanging until the
# hour-long DB lease. Set by the overnight worker to 360000 (6 min). 0 disables.
# AUTOFILL_ACTIVITY_TIMEOUT_MS=360000

# Anti-fraud browser/pacing knobs (Ashby ATS fraud detection flags batches of
# applications that share a device, an IP, or machine-speed behavior).
#
# AUTOFILL_PROXY_TEMPLATE routes every job through a fresh residential IP. The
# {SID} placeholder is substituted with a per-job session id, so each
# application egresses from its own IP (sticky-per-session rotation). With this
# set, the worker runs AUTOFILL_MAX_CONCURRENT jobs concurrently and every job
# also gets a randomized browser fingerprint (UA/platform/viewport/cores/memory,
# India-consistent locale+timezone) seeded from the same session id.
# AUTOFILL_PROXY_TEMPLATE=http://<user>-country-in-session-{SID}:<pass>@geo.iproyal.com:12321
# Legacy single proxy (e.g. Tor SOCKS5): serializes jobs behind one IP and
# rotates the circuit between them. Used only when no template is set.
# AUTOFILL_PROXY=socks5://127.0.0.1:9050
# AUTOFILL_MAX_CONCURRENT=4
# Milliseconds of padding between jobs (default 15000 with a template,
# 60000 on the legacy Tor path). Set to 0 to disable.
# AUTOFILL_INTER_JOB_DELAY_MS=15000
# Multiplies every humanizing sleep in the fill (>= 1). Higher = slower/more
# human-like. Suggested 3-4 for a live Ashby batch.
# AUTOFILL_PACING=3
# AUTOFILL_TYPING=1 types text fields per-keystroke instead of committing
# instantly; AUTOFILL_TYPING_MAX caps the value length that is typed (longer
# values still use the fast native fill).
# AUTOFILL_TYPING=1
# AUTOFILL_TYPING_MAX=400

# Candidate & Pipeline Options
RESUME_URL=https://your-domain.com/resume.pdf
OVERNIGHT_LOOP=true
# CANDIDATE_PERSONA is a fallback when persona.txt is absent.
# CANDIDATE_PERSONA=early-career / new-grad / intern based in India
CANDIDATE_MIN_SALARY=80K INR/month

# Workday job portals. Most Workday career sites require sign-in to apply
# (Intel, Salesforce, …). The adapter always prefers a guest path ("Apply
# Manually") when one exists. Because Workday accounts are per-tenant, it then
# CREATES an account on the tenant with these credentials (filling email /
# password / verify-password + consent), and falls back to signing in when the
# account already exists.
# WORKDAY_EMAIL=your.email@example.com
# WORKDAY_PASSWORD=your_workday_password

# Infrastructure

# Neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
# NEO4J_MAX_CONN_LIFETIME=3600

# PostgreSQL / pgvector
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/agent_memory
# POSTGRES_MIN_POOL=2
# POSTGRES_MAX_POOL=25

# SearXNG
# SEARXNG_URL=http://localhost:8080/search
# SEARXNG_TIMEOUT=6.0

# Embedding Server
# EMBED_URL=http://127.0.0.1:8900/v1
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# HTTP Client

# HTTP_DEFAULT_TIMEOUT=30.0
# HTTP_CONNECT_TIMEOUT=10.0
# HTTP_MAX_KEEPALIVE=20
# HTTP_MAX_CONNECTIONS=100

# Retry Policy

# RETRY_MAX=3
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=30.0
# RETRY_JITTER=true

# Rate Limits (seconds between calls)

# RATE_YC=2.0
# RATE_PRODUCTHUNT=1.5
# RATE_GITHUB=3.0
# RATE_HN=2.0
# RATE_VC=2.0
# RATE_FOUNDER_SOCIAL=1.5

# Scheduler

# SCHEDULER_WORKERS=4
# MAX_QUEUE_SIZE=500
# LEASE_TTL=120.0
# HEARTBEAT_INTERVAL=30.0

# Event Bus

# EVENT_CACHE_MAXSIZE=10000
# EVENT_CACHE_TTL=3600.0

# Pipeline

# PIPELINE_TARGET=15
# MAX_SCRAPE_WORKERS=18
# MATCH_CONCURRENCY=24
# VERIFY_CONCURRENCY=20
# SWEEP_INTERVAL=300.0

# LLM Token Bucket

# LLM_TOKEN_RATE=1.4
# LLM_TOKEN_MAX=30
# LLM_MAX_RETRIES=5
# LLM_RETRY_DELAY=2.0
# LLM_RATE_PENALTY_SECS=60.0
# LLM_MAX_TOKENS=4096

# LinkedIn Guest API

# LINKEDIN_TIMEOUT=12.0
# LINKEDIN_MAX_PAGES=4
# LINKEDIN_DELAY_MIN=1.5
# LINKEDIN_DELAY_MAX=3.5
