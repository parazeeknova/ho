{
  "name": "ho",
  "version": "0.1.6",
  "private": true,
  "description": "ho monorepo",
  "workspaces": [
    "packages/node",
    "apps/*"
  ],
  "scripts": {
    "run": "PYTHONPATH=.:packages/ingest:packages uv run python packages/ingest/scripts/run_all.py",
    "status": "PYTHONPATH=.:packages/ingest:packages uv run python packages/ingest/scripts/run_all.py --status",
    "initm": "PYTHONPATH=.:packages/ingest:packages uv run python packages/autofill/scripts/init_memory.py",
    "intel": "PYTHONPATH=.:packages/ingest:packages uv run python packages/ingest/scripts/intel/radar_intel.py",
    "export": "PYTHONPATH=.:packages/ingest:packages uv run python packages/ingest/scripts/tools/export_accepted.py",
    "health": "uv run python packages/ingest/scripts/tools/health.py",
    "backup": "uv run python packages/ingest/scripts/backup/checkpoint_backup.py",
    "check": "uv run ruff format . && uv run ruff check . --fix && bunx oxfmt && bunx oxlint --fix",
    "check-types": "uv run ty check packages/ingest/src packages/ingest/scripts packages/autofill packages/ml && bun --cwd packages/node typecheck",
    "bump": "uv run python scripts/version_manager.py",
    "bump:dry": "uv run python scripts/version_manager.py --dry-run",
    "docker:web": "docker build -f apps/web/Dockerfile -t ho-web .",
    "docker:node": "docker build -f packages/node/Dockerfile -t ho-node-service .",
    "docker:ingest": "docker build -f packages/ingest/Dockerfile -t ho-ingest .",
    "docker:ml": "docker build -f packages/ml/Dockerfile -t ho-ml .",
    "test": "uv run python -m pytest . -v --ignore=refs && bun run --filter 'autofill-node*' test && bun run --filter 'ho-web' test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "ultracite": "^7.12.4"
  },
  "packageManager": "bun@1.3.13"
}
