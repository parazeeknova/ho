{
  "name": "ho",
  "version": "0.1.0",
  "private": true,
  "description": "ho monorepo - ingest radar pipeline (Python) + autofill product (Python + TypeScript)",
  "workspaces": ["packages/autofill/node"],
  "scripts": {
    "init-memory": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/autofill/scripts/init_memory.py",
    "grill-persona": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/autofill/scripts/grill_persona.py",
    "index-resume": "PYTHONPATH=.:packages/ingest uv run python packages/ingest/scripts/index_resume.py",
    "run": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/run.py",
    "run:overnight": "OVERNIGHT_LOOP=true PYTHONPATH=.:packages/ingest:packages/autofill uv run python -m src.radar.engine.orchestrator",
    "run:dev": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/run.py --no-pipeline",
    "run:worker": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/run.py --worker-only",
    "run:no-cloud": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/run.py --no-cloud",
    "launch": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/launch_pipeline.py --start",
    "crawl": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/local_crawler.py",
    "crawl:ingest": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/local_crawler.py --ingest",
    "crawl:no-tor": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/local_crawler.py --no-tor",
    "intel": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/intel/radar_intel.py",
    "intel:telegram": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/intel/radar_intel.py --telegram",
    "intel:smart": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/intel/smart_intel.py --write",
    "intel:planning": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/intel/planning_pass.py --write",
    "accepted": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/tools/export_accepted.py --out intel/accepted_jobs.csv --eligibility accepted --mode jobs",
    "analytics": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/tools/analytics.py",
    "fc": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/firecrawl.py",
    "graph": "PYTHONPATH=.:packages/ingest:packages/autofill uv run python packages/ingest/scripts/cli/firecrawl.py graph-up",
    "backup": "uv run python packages/ingest/scripts/backup/checkpoint_backup.py",
    "backup-list": "ls -dt checkpoints/*/ 2>/dev/null || echo no checkpoints yet",
    "restore": "uv run python packages/ingest/scripts/backup/checkpoint_restore.py",
    "autobackup": "uv run python packages/ingest/scripts/backup/auto_backup.py",
    "health": "uv run python packages/ingest/scripts/tools/health.py",
    "serve": "uv run python packages/ingest/scripts/serve.py",
    "check": "npm run check-py && npm run check-node",
    "check-py": "uv run ruff format . && uv run ruff check . --fix && uv run mypy packages/ingest/src packages/ingest/scripts packages/autofill --explicit-package-bases",
    "check-node": "npm -w autofill-node run lint && npm -w autofill-node run format:check && npm -w autofill-node run typecheck",
    "test": "uv run python -m pytest . -v --ignore=refs",
    "test:node": "npm -w autofill-node test",
    "lint": "lerna run lint",
    "format": "lerna run format",
    "format:check": "lerna run format:check",
    "typecheck": "lerna run typecheck"
  },
  "devDependencies": {
    "lerna": "^8.2.2"
  }
}
