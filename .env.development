# ho shared dev defaults. COMMITTED so any dev boots `bun run dev` with
# zero setup. Secrets and personal values live in the gitignored root `.env`,
# which overrides everything here (load order: .env.development, .env, shell).
NODE_ENV=development
LOG_LEVEL=INFO
PORT=3002
HOST=0.0.0.0
GENERALCOMPUTE_MODEL=minimax-m2.7
LLM_FALLBACK_MODELS=deepseek-v3.1,deepseek-v3.2
LLM_PER_CALL_TIMEOUT_S=15
EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBED_MODEL=gemini-embedding-2

# Pipeline behavior. The services autorun indefinitely under `bun run dev`;
# no loop flag needed. Single browser +2 concurrent fills, no LaTeX
# tailoring (needs tectonic).
AUTOFILL_MAX_CONCURRENT=2
TAILOR_RESUME=0
AUTOFILL_INTER_JOB_DELAY_MS=20000
RADAR_SESSION_APPLICATION_TARGET=20
DISCOVERY_SOURCE=all
GMAIL_PUSH=1
GMAIL_STREAMING=0

# Throughput tuning.
MAX_SCRAPE_WORKERS=36
MATCH_CONCURRENCY=24
VERIFY_CONCURRENCY=20
SCHEDULER_WORKERS=8
MAX_QUEUE_SIZE=1000
LLM_QUEUE_MAX_IN_FLIGHT=10
LLM_QUEUE_RPM=90
LLM_QUEUE_TPM=180000
LLM_QUEUE_MATCH_TOKENS=2000
HTTP_MAX_CONNECTIONS=200
HTTP_DEFAULT_TIMEOUT=45
FIRECRAWL_TIMEOUT=90
RADAR_HIGH_FREQ_POLL=120
SWEEP_INTERVAL=120
LLM_BUDGET_RADAR_RPM=60
LLM_BUDGET_RADAR_TPM=120000

# Local infra pointers (match docker/docker-compose.yml).
SEARXNG_URL=http://localhost:8080/search
SEARXNG_SECRET=changeme
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5443/agent_memory
LLM_BUDGET_REDIS_URL=redis://127.0.0.1:6380/1
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
TOR_EXIT_COUNTRY=IN
